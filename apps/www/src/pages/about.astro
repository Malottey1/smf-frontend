---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { Picture } from "astro:assets";
import lagosBusinessMeeting from "../assets/images/lagos-business-meeting.jpg";
import lagosTeamPhoto from "../assets/images/lagos-team-photo.jpg";

// "History" and "Certifications & partnerships" sections are
// intentionally not on this page — neither is in the source documents,
// and there's no honest photo or copy substitute for a specific,
// checkable fact like a founding date or a certification. Tracked in
// LAUNCH-CHECKLIST.md instead of shown here as an empty labelled box.
---
<Layout
  title="About"
  description="About Numeric Technologies — a Ghana-based IT solutions company for the pharmaceutical and healthcare sector."
>
  <PageHero
    image={lagosBusinessMeeting}
    alt="A team meeting around a table in a bright conference room."
  />

  <section class="section about-hero">
    <div class="wrap">
      <h1>About</h1>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose about-copy">
      <p>
        Numeric Technologies is a Ghana-based IT solutions company
        specializing in the customization and integration of software
        for the pharmaceutical and healthcare sector. We combine deep
        regulatory domain expertise with hands-on software development
        to help pharmaceutical manufacturers, distributors, and
        pharmacies build the systems they need to operate safely,
        efficiently, and in full compliance with FDA Ghana requirements.
      </p>
      <p>
        Our work today spans regulatory and quality compliance services
        — GMP/QMS gap assessments, audit readiness, and documentation
        systems — alongside IT support and systems integration for the
        ERPs, POS, and inventory platforms that keep pharmaceutical
        distribution running. Every engagement feeds directly into our
        long-term mission: building a dedicated Quality Management
        System (QMS) and Laboratory Information Management System
        (LIMS) platform, designed to integrate with FDA Ghana's digital
        infrastructure and support both the regulator and pharmaceutical
        companies in meeting the highest international standards.
      </p>
      <p>
        We see ourselves as more than a vendor. As Ghana works toward
        advancing its WHO regulatory maturity from Level 3 to Level 4,
        and as global pharmaceutical companies look to enter West
        Africa through the AfCFTA, we aim to be the trusted local
        technical partner that makes that growth possible — de-risking
        compliance, strengthening local capability, and connecting
        international expertise with African market opportunity.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>Mission</h2>
      <p class="mission-quote">
        Our mission is to deliver creative, technical solutions tailored
        to unique business needs, providing flexible and scalable
        systems that make processes efficient, practical, and
        future-ready.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap team-grid">
      <h2>Team</h2>
      <Picture
        src={lagosTeamPhoto}
        alt="Three colleagues reviewing something together on a laptop."
        widths={[400, 800, 1200]}
        sizes="(min-width: 780px) 40rem, 100vw"
        formats={["avif", "webp"]}
        loading="lazy"
        class="team-photo"
      />
    </div>
  </section>
</Layout>

<style>
  .about-hero h1 { font-size: var(--text-3xl); }
  .about-copy p + p { margin-top: var(--space-5); }
  .about-copy p { font-size: var(--text-md); }

  h2 { font-size: var(--text-xl); margin-bottom: var(--space-6); }

  .mission-quote {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
    max-width: 30ch;
  }

  .team-photo {
    width: 100%;
    max-width: 40rem;
    height: auto;
    border: 1px solid var(--color-rule);
  }
</style>
