---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Contact" description="Contact Numeric Technologies.">
  <section class="section contact-hero">
    <div class="wrap contact-layout">
      <div>
        <h1>Contact</h1>
        <p class="prose lead">
          For regulatory advisory, quality systems work, or to talk
          about GxP Console, get in touch.
        </p>

        <dl class="contact-facts">
          <div>
            <dt>Address</dt>
            <dd>[PLACEHOLDER — see LAUNCH-CHECKLIST.md]</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd>[PLACEHOLDER]</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>[PLACEHOLDER]</dd>
          </div>
        </dl>
      </div>

      <form class="enquiry-form" aria-describedby="enquiry-note">
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" disabled />
        </div>
        <div class="field">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" autocomplete="organization" disabled />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" disabled />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" disabled></textarea>
        </div>
        <button type="submit" class="btn" disabled>Send enquiry</button>
        <p id="enquiry-note" class="form-note">
          <strong>[PLACEHOLDER]</strong> — this form isn't connected to
          anything yet. It's built to the real field set an enquiry form
          needs; wiring it up depends on where enquiries should be
          delivered. See LAUNCH-CHECKLIST.md → "Where the enquiry form
          should deliver."
        </p>
      </form>
    </div>
  </section>
</Layout>

<style>
  .contact-hero h1 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
  .lead { font-size: var(--text-md); color: var(--color-text-muted); margin-bottom: var(--space-8); }

  .contact-layout { display: grid; gap: var(--space-12); }
  @media (min-width: 780px) {
    .contact-layout { grid-template-columns: 1fr 1fr; }
  }

  .contact-facts { display: grid; gap: var(--space-5); border-top: 1px solid var(--color-rule); padding-top: var(--space-6); }
  .contact-facts dt {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .contact-facts dd { margin: 0; font-size: var(--text-md); font-weight: var(--weight-semibold); }

  .enquiry-form { display: flex; flex-direction: column; gap: var(--space-5); }
  .field label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
  }
  .field input, .field textarea {
    width: 100%;
    font: inherit;
    font-size: var(--text-sm);
    padding: var(--space-3);
    border: 1px solid var(--color-rule);
    background: var(--color-bg);
    color: var(--color-text);
    resize: vertical;
  }
  .field input:disabled, .field textarea:disabled { background: var(--color-bg-alt); color: var(--color-text-muted); }
  .enquiry-form .btn { cursor: not-allowed; align-self: flex-start; }
  .form-note { font-size: var(--text-xs); color: var(--color-text-muted); border-top: 1px solid var(--color-rule); padding-top: var(--space-4); }
</style>
