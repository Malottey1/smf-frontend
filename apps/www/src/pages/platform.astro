---
import Layout from "../layouts/Layout.astro";
import Monogram from "../components/Monogram.astro";

// GxP Console's own palette + IBM Plex Sans, copied verbatim from
// apps/smf-frontend/src/design-system/tokens.css — real values from the
// actual application, not invented for this page. Scoped to
// .product-panel only; the rest of this page (and site) stays in the
// corporate Indigo & Gold system. That split IS the endorsement
// relationship the brand brief asks for.
---
<Layout
  title="Platform"
  description="GxP Console — Numeric Technologies' Quality Management System and Laboratory Information Management System platform, in development."
>
  <section class="section platform-hero">
    <div class="wrap">
      <h1>Platform</h1>
      <p class="prose lead">
        Every engagement feeds directly into our long-term mission:
        building a dedicated Quality Management System (QMS) and
        Laboratory Information Management System (LIMS) platform,
        designed to integrate with FDA Ghana's digital infrastructure and
        support both the regulator and pharmaceutical companies in
        meeting the highest international standards.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="endorsement-line">From Numeric Technologies</p>
      <div class="product-panel">
        <div class="panel-top">
          <div class="panel-brand">
            <Monogram class="panel-mono" />
            <div>
              <span class="panel-name">GxP Console</span>
              <span class="panel-sub">Ghana FDA · GMP Compliance Platform</span>
            </div>
          </div>
          <span class="panel-status">IN DEVELOPMENT</span>
        </div>
        <p class="panel-body">
          A QMS and LIMS platform built specifically for FDA Ghana
          compliance — quality management and laboratory data in one
          system, designed to connect to the regulator's own digital
          infrastructure rather than sit apart from it.
        </p>
        <p class="panel-note">
          [PLACEHOLDER] — what more can be said publicly about GxP
          Console, and when, is tracked in LAUNCH-CHECKLIST.md. Nothing
          about features, timeline, or availability is stated here beyond
          what's above.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap register-grid">
      <div>
        <h2>Register interest</h2>
        <p class="prose">
          Leave your email and we'll reach out when there's more to share
          about GxP Console.
        </p>
      </div>
      <form class="register-form" aria-describedby="register-note">
        <label for="register-email">Email address</label>
        <div class="register-row">
          <input type="email" id="register-email" name="email" placeholder="you@company.com" disabled />
          <button type="submit" class="btn" disabled>Notify me</button>
        </div>
        <p id="register-note" class="form-note">
          [PLACEHOLDER] — this form isn't connected yet. See
          LAUNCH-CHECKLIST.md → "Where the enquiry form should deliver."
        </p>
      </form>
    </div>
  </section>
</Layout>

<style>
  /* Self-hosted, scoped to this page only — the rest of the site never
     loads IBM Plex. Downloaded from Google Fonts' gstatic CDN (same
     approach as packages/brand-corporate/src/fonts), latin subset. */
  @font-face {
    font-family: "IBM Plex Sans";
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("../assets/fonts/ibm-plex-sans-variable-latin.woff2") format("woff2-variations"),
         url("../assets/fonts/ibm-plex-sans-variable-latin.woff2") format("woff2");
  }

  .platform-hero h1 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
  .lead { font-size: var(--text-md); color: var(--color-text-muted); max-width: var(--prose-max); }

  .endorsement-line {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  /* ---- GxP Console's own visual system, scoped to this panel only ---- */
  .product-panel {
    background: #0c2036; /* --navy-deep */
    color: #e7eef2; /* --rail-heading */
    padding: var(--space-8);
    font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
  }
  .panel-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid #1d3a52; /* --rail-border */
  }
  .panel-brand { display: flex; align-items: center; gap: var(--space-3); }
  .panel-mono { width: 30px; height: 30px; color: #ffffff; flex-shrink: 0; }
  .panel-name { display: block; font-weight: 600; font-size: 1.15rem; color: #ffffff; }
  .panel-sub { display: block; font-size: 0.8rem; color: #8fa3b3; margin-top: 2px; }
  .panel-status {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    /* A lightened tint of --teal, not --teal itself: #0e6b5c directly on
       this chip's background measured 2.07:1 (fails AA) — verified, not
       assumed, same as everywhere else on this site. */
    color: #9fd9c9;
    background: #12324a;
    border: 1px solid #1d3a52;
    padding: 4px 10px;
    align-self: flex-start;
  }
  .panel-body { font-size: 1rem; line-height: 1.6; color: #c9d6e0; max-width: 56ch; margin-bottom: var(--space-6); }
  .panel-note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: #8fa3b3;
    border-top: 1px solid #1d3a52;
    padding-top: var(--space-4);
  }

  .register-grid { display: grid; gap: var(--space-8); }
  @media (min-width: 780px) {
    .register-grid { grid-template-columns: 1fr 1fr; align-items: start; }
  }
  .register-grid h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .register-form label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
  }
  .register-row { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .register-row input {
    flex: 1 1 14rem;
    font: inherit;
    font-size: var(--text-sm);
    padding: var(--space-3);
    border: 1px solid var(--color-rule);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .register-row input:disabled { background: var(--color-bg-alt); color: var(--color-text-muted); }
  .register-row .btn { cursor: not-allowed; }
  .form-note { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-3); }
</style>
