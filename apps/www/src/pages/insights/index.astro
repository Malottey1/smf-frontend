---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import lagosPharmacy from "../../assets/images/lagos-pharmacy-counter.jpg";

const posts = (await getCollection("insights")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout
  title="Insights"
  description="Regulatory intelligence from Numeric Technologies."
>
  <PageHero
    image={lagosPharmacy}
    alt="A pharmacist and a customer review a medicine box together at a pharmacy counter."
  />

  <section class="section insights-hero">
    <div class="wrap">
      <h1>Insights</h1>
      <p class="prose lead">
        Regulatory intelligence & policy monitoring is one of our
        Advisory & Strategy services — this is where we publish it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ol class="post-list">
        {posts.map((post) => (
          <li class="post-row">
            <a href={`/insights/${post.id}/`}>
              <div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}
              </time>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

<style>
  .insights-hero h1 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
  .lead { font-size: var(--text-md); color: var(--color-text-muted); }

  .post-list { border-top: 1px solid var(--color-rule); }
  .post-row { border-bottom: 1px solid var(--color-rule); }
  .post-row a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-8);
    text-decoration: none;
  }
  .post-row a > div { min-width: 0; flex: 1 1 16rem; }
  .post-row h2 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .post-row p { color: var(--color-text-muted); max-width: 52ch; }
  .post-row time { font-size: var(--text-xs); color: var(--color-text-muted); white-space: nowrap; }
</style>
