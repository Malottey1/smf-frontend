---
import Layout from "../layouts/Layout.astro";
import PlaceholderPhoto from "../components/PlaceholderPhoto.astro";

const pillars = [
  {
    n: "01",
    name: "Advisory & Strategy",
    tagline: "Expert guidance to navigate Ghana's regulatory landscape and plan market entry with confidence.",
  },
  {
    n: "02",
    name: "Quality Systems",
    tagline: "End-to-end quality infrastructure that keeps you audit-ready, always.",
  },
  {
    n: "03",
    name: "Digital & Technology",
    tagline: "Purpose-built platforms that digitize compliance and connect you to regulatory systems.",
  },
  {
    n: "04",
    name: "Safety & Trials",
    tagline: "Comprehensive support across clinical development and post-market safety.",
  },
];
---
<Layout
  title="Home"
  description="Numeric Technologies is a Ghana-based IT solutions company specializing in the customization and integration of software for the pharmaceutical and healthcare sector."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Numeric Technologies</h1>
        <p class="prose lead">
          Numeric Technologies is a Ghana-based IT solutions company
          specializing in the customization and integration of software for
          the pharmaceutical and healthcare sector.
        </p>
        <p class="prose">
          We combine deep regulatory domain expertise with hands-on software
          development to help pharmaceutical manufacturers, distributors, and
          pharmacies build the systems they need to operate safely,
          efficiently, and in full compliance with FDA Ghana requirements.
        </p>
      </div>
    </div>
    <div class="hero-photo-frame">
      <PlaceholderPhoto
        ratio="21/9"
        minHeight="320px"
        shot="A pharmaceutical manufacturing floor or QC laboratory in Ghana — a technician at an instrument, natural light, documentary style. Not staged, not AI-generated. See README.md shot list."
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <h2>What we do today</h2>
      <div class="prose">
        <p>
          Our work today spans regulatory and quality compliance services —
          GMP/QMS gap assessments, audit readiness, and documentation systems
          — alongside IT support and systems integration for the ERPs, POS,
          and inventory platforms that keep pharmaceutical distribution
          running.
        </p>
        <p>
          Every engagement feeds directly into our long-term mission:
          building a dedicated Quality Management System (QMS) and
          Laboratory Information Management System (LIMS) platform, designed
          to integrate with FDA Ghana's digital infrastructure and support
          both the regulator and pharmaceutical companies in meeting the
          highest international standards.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>Where we focus</h2>
      <ol class="pillar-cards">
        {pillars.map((p) => (
          <li class="pillar-card">
            <span class="pillar-n" aria-hidden="true">{p.n}</span>
            <h3>{p.name}</h3>
            <p>{p.tagline}</p>
          </li>
        ))}
      </ol>
      <a class="text-link" href="/services">See all four in detail →</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap positioning-grid">
      <div class="prose">
        <h2>The moment for Ghana</h2>
        <p>
          We see ourselves as more than a vendor. As Ghana works toward
          advancing its WHO regulatory maturity from Level 3 to Level 4, and
          as global pharmaceutical companies look to enter West Africa
          through the AfCFTA, we aim to be the trusted local technical
          partner that makes that growth possible — de-risking compliance,
          strengthening local capability, and connecting international
          expertise with African market opportunity.
        </p>
      </div>
      <PlaceholderPhoto
        ratio="4/5"
        shot="Ghanaian pharmaceutical distribution or a community pharmacy counter — real work, real people, Accra or Kumasi. Not staged. See README.md shot list."
      />
    </div>
  </section>

  <section class="section mission-section">
    <div class="wrap">
      <p class="mission-quote">
        Our mission is to deliver creative, technical solutions tailored to
        unique business needs, providing flexible and scalable systems that
        make processes efficient, practical, and future-ready.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="wrap contact-grid">
      <div>
        <h2>Get in touch</h2>
        <p class="prose">
          For regulatory advisory, quality systems work, or to talk about
          GxP Console, reach out — full contact details are on the <a class="text-link" href="/contact">Contact page</a>.
        </p>
      </div>
      <dl class="contact-facts">
        <div><dt>Address</dt><dd>[PLACEHOLDER — see LAUNCH-CHECKLIST.md]</dd></div>
        <div><dt>Phone</dt><dd>[PLACEHOLDER]</dd></div>
        <div><dt>Email</dt><dd>[PLACEHOLDER]</dd></div>
      </dl>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: var(--space-16); }
  .hero-grid { padding-bottom: var(--space-12); }
  .hero-text { max-width: 46rem; }
  .hero-text h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 860px) {
    .hero-text h1 { font-size: var(--text-4xl); }
  }
  .lead {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .hero-text .prose + .prose { margin-top: var(--space-4); }
  .hero-photo-frame { padding-inline: 0; }
  @media (min-width: 720px) {
    .hero-photo-frame { padding-inline: var(--space-8); }
  }

  .two-col { display: grid; gap: var(--space-6); }
  @media (min-width: 780px) {
    .two-col { grid-template-columns: 18rem 1fr; gap: var(--space-16); }
  }
  .two-col h2 { font-size: var(--text-xl); }
  .two-col .prose p + p { margin-top: var(--space-4); }

  .pillar-cards {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    list-style: none;
  }
  @media (min-width: 640px) {
    .pillar-cards { grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  }
  .pillar-card {
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    border-top: 4px solid var(--color-accent);
    padding: var(--space-6);
  }
  .pillar-n {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .pillar-card h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .pillar-card p { color: var(--color-text-muted); }
  .pillar-cards + .text-link { display: inline-block; margin-top: var(--space-6); }

  .positioning-grid { display: grid; gap: var(--space-8); align-items: center; }
  @media (min-width: 780px) {
    .positioning-grid { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-16); }
  }
  .positioning-grid h2 { font-size: var(--text-xl); margin-bottom: var(--space-5); }

  .mission-section { padding-block: var(--space-32); }
  .mission-quote {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
    max-width: 26ch;
  }
  @media (min-width: 860px) {
    .mission-quote { font-size: var(--text-3xl); }
  }

  .contact-section { background: var(--color-inverse-bg); color: var(--color-inverse-text); }
  .contact-section h2 { color: var(--color-inverse-text); font-size: var(--text-xl); margin-bottom: var(--space-4); }
  .contact-section .text-link { color: var(--color-inverse-text); text-decoration-color: var(--color-accent); }
  .contact-grid { display: grid; gap: var(--space-10); }
  @media (min-width: 780px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
  }
  .contact-facts { display: grid; gap: var(--space-5); }
  .contact-facts dt {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #C9BFE0;
  }
  .contact-facts dd { margin: 0; font-size: var(--text-md); }
</style>
