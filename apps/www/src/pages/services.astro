---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import lagosCasualMeeting from "../assets/images/lagos-casual-meeting.jpg";

// Icons are hand-drawn geometric SVGs (stroke-based, currentColor, 1.75
// stroke) — same "quiet, geometric" register as the monogram, not an
// icon-pack import. Kept as raw markup here since there are only four.
const icons = {
  compass: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.75"/><path d="M15 9 L12.8 12.8 L9 15 L11.2 11.2 Z" fill="currentColor"/></svg>`,
  check: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.75"/><path d="M8 12.5 L10.5 15 L16 9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"/></svg>`,
  layers: `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.75"/><rect x="8" y="8" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.75"/></svg>`,
  shield: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 L19 6 V12 C19 16.5 16 19.5 12 21 C8 19.5 5 16.5 5 12 V6 Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="miter"/></svg>`,
};

// Pillar taglines are verbatim from Services.pdf (see CONTENT-SOURCE.md).
// Each capability's explanation below defines the industry term itself —
// GMP, CAPA, PSUR, GFIRMS, TMF, LIMS, etc. are established regulatory
// vocabulary, not claims about Numeric Technologies' own track record.
// That's the line: definitional ("X is...") stays out of "no claim not in
// the source docs" territory; anything shaped like "we have delivered..."
// would not.
const pillars = [
  {
    icon: icons.compass,
    name: "Advisory & Strategy",
    tagline: "Expert guidance to navigate Ghana's regulatory landscape and plan market entry with confidence.",
    items: [
      {
        name: "Regulatory strategy & product classification",
        detail: "How a product is classified — as a medicine, a medical device, or another category — determines every requirement that follows: labelling, the approval pathway, and which standards apply.",
      },
      {
        name: "Market entry & compliance risk assessment",
        detail: "Understanding what a market requires before committing resources to it, so compliance risk is identified early rather than discovered partway through an application.",
      },
      {
        name: "FDA Ghana submission management (GFIRMS)",
        detail: "GFIRMS is the Ghana FDA's electronic Regulatory Information Management System — the system through which applications are submitted to and tracked with the regulator.",
      },
      {
        name: "Regulatory intelligence & policy monitoring",
        detail: "Tracking regulatory changes as they're published, rather than encountering them for the first time at the next audit or submission.",
      },
    ],
  },
  {
    icon: icons.check,
    name: "Quality Systems",
    tagline: "End-to-end quality infrastructure that keeps you audit-ready, always.",
    items: [
      {
        name: "QMS design & implementation",
        detail: "A Quality Management System is the documented set of processes an organization uses to consistently meet quality and regulatory requirements.",
      },
      {
        name: "GMP gap assessments & mock audits",
        detail: "Good Manufacturing Practice gap assessments compare current practice against the applicable standard — surfacing a gap before a real inspection does.",
      },
      {
        name: "SOP development & document control",
        detail: "Standard Operating Procedures are the written instructions that make a process repeatable and auditable. Document control is what keeps them current, versioned, and traceable.",
      },
      {
        name: "CAPA & deviation management",
        detail: "Corrective and Preventive Action (CAPA) is the formal process for investigating a deviation from an expected result and preventing it from recurring.",
      },
    ],
  },
  {
    icon: icons.layers,
    name: "Digital & Technology",
    tagline: "Purpose-built platforms that digitize compliance and connect you to regulatory systems.",
    items: [
      {
        name: "QMS & LIMS platform deployment",
        detail: "A Laboratory Information Management System (LIMS) manages lab samples, test results, and records. Deployed alongside a QMS, it connects quality processes to the data that supports them — see our own platform, GxP Console.",
      },
      {
        name: "FDA system integration & data connectivity",
        detail: "Connecting internal systems to a regulator's digital infrastructure so data moves between them directly, rather than through manual re-entry.",
      },
      {
        name: "Inventory, expiry & traceability systems",
        detail: "Tracking stock levels, expiry dates, and chain of custody for pharmaceutical products as they move through distribution.",
      },
      {
        name: "Custom pharma software development",
        detail: "Software built for a specific pharmaceutical or healthcare workflow, rather than adapted from a generic template.",
      },
    ],
  },
  {
    icon: icons.shield,
    name: "Safety & Trials",
    tagline: "Comprehensive support across clinical development and post-market safety.",
    items: [
      {
        name: "Clinical trial operations & TMF management",
        detail: "A Trial Master File (TMF) is the structured set of documents that demonstrates a clinical trial was conducted according to protocol and applicable regulation.",
      },
      {
        name: "Pharmacovigilance & adverse event reporting",
        detail: "Pharmacovigilance is the ongoing monitoring of a medicine's effects after approval, including the reporting of adverse events as they occur.",
      },
      {
        name: "Signal detection & risk management",
        detail: "A safety signal is new information suggesting a possible link between a medicine and an adverse outcome. Detecting it early narrows the response a company needs to take.",
      },
      {
        name: "Periodic safety update reports (PSURs)",
        detail: "A PSUR is a scheduled report summarizing a medicine's safety data over a defined period, submitted to regulators as part of ongoing post-market surveillance.",
      },
    ],
  },
];
---
<Layout
  title="Services"
  description="Advisory & Strategy, Quality Systems, Digital & Technology, and Safety & Trials — Numeric Technologies' four service pillars, in detail."
>
  <PageHero
    image={lagosCasualMeeting}
    alt="Four colleagues talking together in a bright office space."
  />

  <section class="section services-hero">
    <div class="wrap">
      <h1>Services</h1>
      <p class="prose lead">
        Four pillars, spanning the regulatory, quality, technology and
        safety work pharmaceutical and healthcare organizations need to
        operate in Ghana.
      </p>
    </div>
  </section>

  <section class="section pillar-section">
    <div class="wrap">
      <div class="pillar-cards">
        {pillars.map((pillar) => (
          <article class="pillar-card" id={pillar.name.toLowerCase().replace(/[^a-z]+/g, "-")}>
            <div class="pillar-icon" set:html={pillar.icon} />
            <h2>{pillar.name}</h2>
            <p class="tagline">{pillar.tagline}</p>
            <ul class="capability-list">
              {pillar.items.map((item) => (
                <li>
                  <strong>{item.name}</strong>
                  <p>{item.detail}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <p class="prose">
        Looking for the platform itself, not the services around it? See <a class="text-link" href="/platform">GxP Console</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .services-hero h1 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
  .lead { font-size: var(--text-md); color: var(--color-text-muted); }

  .pillar-cards {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 780px) {
    .pillar-cards { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
  }
  .pillar-card {
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    border-top: 4px solid var(--color-accent);
    padding: var(--space-8);
  }
  .pillar-icon { width: 40px; height: 40px; color: var(--color-accent); margin-bottom: var(--space-5); }
  .pillar-icon svg { width: 100%; height: 100%; }
  .pillar-card h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .pillar-card .tagline { color: var(--color-text-muted); margin-bottom: var(--space-6); max-width: 42ch; }

  .capability-list { display: grid; gap: var(--space-5); }
  .capability-list li { list-style: none; }
  .capability-list strong { display: block; font-size: var(--text-sm); font-weight: var(--weight-bold); margin-bottom: var(--space-1); }
  .capability-list p { color: var(--color-text-muted); font-size: var(--text-sm); }
</style>
