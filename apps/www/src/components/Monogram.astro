---
// Inlined so it themes via currentColor with zero extra request.
// Source of truth: packages/brand-corporate/src/logo/monogram.svg
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 32 32" role="img" aria-label="Numeric Technologies monogram">
  <path fill-rule="evenodd" fill="currentColor" d="M4,4 L10,4 L10,28 L4,28 Z M22,4 L28,4 L28,28 L22,28 Z M4,4 L10,4 L28,28 L22,28 Z M14,15 L19,17 L15,19 Z"/>
